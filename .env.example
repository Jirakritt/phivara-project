# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string, e.g.
# postgresql://user:password@host:5432/phivara_cms
DATABASE_URI=

# Any long random string — used to sign auth tokens/cookies.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=

# Where Payload's config file lives relative to the project root.
PAYLOAD_CONFIG_PATH=cms/payload.config.ts

# Public URL of this app, used for admin links, emails, and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Analytics — optional. Leave blank until you have real IDs from your own
# Google Analytics / Meta Business accounts. Nothing is loaded (not even a
# blocked/no-op state) unless BOTH an id is set here AND the visitor accepts
# the PDPA consent banner — see public/js/consent-banner.js.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Member-account transactional email (verify-account / forgot-password).
# Admin picks the active provider in CMS > Email Settings — only fill in
# whichever provider(s) you actually use. See DEPLOY.md for setup steps.
EMAIL_FROM_ADDRESS=no-reply@phivara.site
EMAIL_FROM_NAME=PHIVARA
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SENDER_UPN=
