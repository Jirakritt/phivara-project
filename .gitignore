node_modules
.next
.env
*.log
.DS_Store

# Payload's local upload storage (Media collection files + resized
# variants) — regenerated every `npm run seed` run, so it doesn't belong in
# git history. Production should move this to cloud storage (S3 or
# equivalent) rather than local disk anyway — see the "remaining work"
# list for that item.
media

# TypeScript incremental build cache — machine-specific, safe to delete.
tsconfig.tsbuildinfo

# Local database/media backups (see the backup instructions) — these can
# contain real visitor data (Leads) once the site is live, so they must
# never end up in git history.
backups
